{
  "name": "@supabase/middleware",
  "version": "1.0.0",
  "description": "Composable, type-safe middleware for Web Fetch handlers. A middleware is a (config, handler) wrapper that runs against the inbound Request, contributes a typed key to ctx, and either short-circuits or falls through — the same shape across every runtime and framework.",
  "keywords": [
    "middleware",
    "fetch",
    "edge",
    "supabase"
  ],
  "homepage": "https://github.com/supabase/middleware#readme",
  "bugs": {
    "url": "https://github.com/supabase/middleware/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supabase/middleware.git"
  },
  "license": "MIT",
  "author": "supabase",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./feature-flag": {
      "import": {
        "types": "./dist/middleware/feature-flag/index.d.mts",
        "default": "./dist/middleware/feature-flag/index.mjs"
      },
      "require": {
        "types": "./dist/middleware/feature-flag/index.d.cts",
        "default": "./dist/middleware/feature-flag/index.cjs"
      }
    },
    "./cors": {
      "import": {
        "types": "./dist/middleware/cors/index.d.mts",
        "default": "./dist/middleware/cors/index.mjs"
      },
      "require": {
        "types": "./dist/middleware/cors/index.d.cts",
        "default": "./dist/middleware/cors/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "skills",
    "src/**/README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3",
  "scripts": {
    "build": "tsdown",
    "check-exports": "attw --pack .",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "docs": "typedoc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "smoke": "node scripts/smoke-load.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deno": "deno test --no-check --allow-env --allow-net test/runtimes/deno",
    "test:bun": "bun test test/runtimes/bun",
    "test:workers": "pnpm --dir test/runtimes/workers install && pnpm --dir test/runtimes/workers exec vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:min": "pnpm --dir test/ts-floor install --ignore-workspace && pnpm --dir test/ts-floor exec tsc --noEmit --project ../../tsconfig.json",
    "typecheck:consumer": "pnpm --dir test/ts-floor install --ignore-workspace && pnpm --dir test/ts-floor exec tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "eslint": "^10.0.2",
    "prettier": "3.8.1",
    "tsdown": "^0.20.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "std-env": "^4.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
