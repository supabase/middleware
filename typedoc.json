{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/middleware/feature-flag/index.ts",
    "src/middleware/cors/index.ts"
  ],
  "out": "api-docs",
  "json": "api-docs/spec.json",
  "name": "@supabase/middleware",
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "navigationLinks": {
    "GitHub": "https://github.com/supabase/middleware"
  },
  "projectDocuments": [
    "src/core/README.md",
    "src/middleware/README.md",
    "src/middleware/cors/README.md",
    "src/middleware/feature-flag/README.md"
  ],
  "highlightLanguages": [
    "typescript",
    "javascript",
    "bash",
    "sh",
    "json",
    "yaml"
  ],
  "sort": ["source-order"],
  "kindSortOrder": ["Function", "Class", "Interface", "TypeAlias", "Enum"],
  "categorizeByGroup": true
}
