{
  "name": "@supabase/middleware",
  "version": "0.3.1",
  "exports": {
    ".": "./src/index.ts",
    "./feature-flag": "./src/middleware/feature-flag/index.ts",
    "./cors": "./src/middleware/cors/index.ts"
  },
  "imports": {
    "std-env": "npm:std-env@^4.2.0"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/README.md",
      "docs/**/*.md",
      "skills/**/*.md",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts"
    ]
  }
}
